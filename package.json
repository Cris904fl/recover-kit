{
  "name": "recoverkit",
  "version": "0.1.0",
  "private": true,
  "description": "Abandoned cart recovery SaaS — automated email & SMS sequences",
  "workspaces": ["web", "api"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=web\" \"npm run dev --workspace=api\"",
    "build": "npm run build --workspace=web && npm run build --workspace=api",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  }
}
